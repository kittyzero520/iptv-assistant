#!/bin/sh /etc/rc.common
# iptv-assistant: Force IGMP version on WAN/IPTV interfaces + tune kernel buffers
# Reads UCI /etc/config/iptv_assistant, writes /etc/sysctl.d/10-iptv-assistant.conf,
# then runs `sysctl --system` to apply.
# Menu: Network → IPTV 网络助手 (IPTV Assistant)

START=99
USE_PROCD=1
CONF_FILE=/etc/sysctl.d/10-iptv-assistant.conf

generate_conf() {
	local enabled rmem_max rmem_default netdev_max_backlog
	config_load iptv_assistant
	config_get enabled main enabled '1'

	rm -f "$CONF_FILE"
	[ "$enabled" = "1" ] || return 0

	config_get rmem_max main rmem_max '16777216'
	config_get rmem_default main rmem_default '2097152'
	config_get netdev_max_backlog main netdev_max_backlog '5000'

	mkdir -p "$(dirname "$CONF_FILE")"
	{
		echo "# Generated by iptv-assistant. Edit via UCI: /etc/config/iptv_assistant"
		echo "net.core.rmem_max=$rmem_max"
		echo "net.core.rmem_default=$rmem_default"
		echo "net.core.netdev_max_backlog=$netdev_max_backlog"
		local count=0
		while :; do
			local sname igmpver
			sname=$(uci -q get "iptv_assistant.@interface[$count].iface")
			[ -z "$sname" ] && break
			igmpver=$(uci -q get "iptv_assistant.@interface[$count].igmp_version")
			[ -z "$igmpver" ] && igmpver='2'
			[ "$igmpver" = "0" ] || echo "net.ipv4.conf.$sname.force_igmp_version=$igmpver"
			count=$((count + 1))
		done
	} > "$CONF_FILE"
}

apply_bridge() {
	local device snooping querier
	device=$(uci -q get iptv_assistant.bridge.device)
	[ -z "$device" ] && return 0
	[ -d "/sys/class/net/$device/bridge" ] || return 0
	snooping=$(uci -q get iptv_assistant.bridge.snooping)
	querier=$(uci -q get iptv_assistant.bridge.querier)
	[ -z "$snooping" ] && snooping='1'
	[ -z "$querier" ] && querier='1'
	echo "$snooping" > "/sys/class/net/$device/bridge/multicast_snooping" 2>/dev/null
	echo "$querier" > "/sys/class/net/$device/bridge/multicast_querier" 2>/dev/null
}

mask2cidr() {
	local n=0 o
	OLDIFS=$IFS
	IFS=.
	for o in $1; do
		case $o in
			255) n=$((n + 8)) ;;
			254) n=$((n + 7)) ;;
			252) n=$((n + 6)) ;;
			248) n=$((n + 5)) ;;
			240) n=$((n + 4)) ;;
			224) n=$((n + 3)) ;;
			192) n=$((n + 2)) ;;
			128) n=$((n + 1)) ;;
			0) ;;
			*) n=32; break ;;
		esac
	done
	IFS=$OLDIFS
	echo "$n"
}

apply_fcc() {
	local enabled iface target netmask cidr dev
	enabled=$(uci -q get iptv_assistant.fcc.enabled)
	target=$(uci -q get iptv_assistant.fcc.target)
	[ -z "$target" ] && target='121.60.255.120'
	netmask=$(uci -q get iptv_assistant.fcc.netmask)
	[ -z "$netmask" ] && netmask='255.255.255.255'
	cidr=$(mask2cidr "$netmask")

	# 关闭:删除路由(带设备名与不带设备名各试一次)
	if [ "$enabled" != "1" ]; then
		ip route del "$target"/32 2>/dev/null
		return 0
	fi

	# 运行时设备名三级推导:手填 device > pppoe-<接口名> 推导 > ubus 查询
	iface=$(uci -q get iptv_assistant.fcc.interface)
	[ -z "$iface" ] && iface='wan1'
	dev=$(uci -q get iptv_assistant.fcc.device)
	if [ -z "$dev" ] && [ -d "/sys/class/net/pppoe-$iface" ]; then
		dev="pppoe-$iface"
	fi
	if [ -z "$dev" ]; then
		dev=$(ubus call "network.interface.$iface" status 2>/dev/null | jsonfilter -e '@.device' 2>/dev/null)
	fi
	[ -n "$dev" ] || return 0

	ip route replace "$target/$cidr" dev "$dev" 2>/dev/null
}

apply_now() {
	generate_conf
	apply_bridge
	apply_fcc
	sysctl --system 2>/dev/null || sysctl -p "$CONF_FILE"
}

start_service() { apply_now; }
reload_service() { apply_now; }
service_triggers() {
	procd_add_reload_trigger "iptv_assistant"
	# network 重载会重置桥的组播 sysfs 状态，随之自动补写
	procd_add_reload_trigger "network"
}
